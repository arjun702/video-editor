# Copy to .env. Leave keys blank to rank hooks on this machine.

# Highlight model. auto uses the first key it finds, otherwise the local ranker.
LLM_PROVIDER=auto

# Google AI Studio key. Default model is Gemini Flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional swaps. Only used when LLM_PROVIDER is openai or anthropic,
# or when that key is the first one set under auto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# faster-whisper model pulled on first transcription: tiny, base, small, medium.
WHISPER_MODEL=base
# auto, cpu, or cuda. Apple Silicon uses cpu + int8.
WHISPER_DEVICE=auto

# Jobs, uploads, and rendered clips.
DATA_DIR=data
